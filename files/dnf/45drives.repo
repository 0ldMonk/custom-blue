[45drives_enterprise]
name=45Drives Enterprise
# el9 hardcoded: 45Drives has no Fedora builds, so $releasever would 404
baseurl=https://repo.45drives.com/enterprise/rocky/el9/stable
# scoped: the repo also carries older EL9 cockpit/samba that would replace Fedora's
includepkgs=cockpit-file-sharing cockpit-identities
enabled=1
gpgcheck=1
# repo_gpgcheck=1 hangs the build: dnf5 ignores rpm --import'ed keys for repomd
repo_gpgcheck=0
gpgkey=https://repo.45drives.com/key/gpg.asc
